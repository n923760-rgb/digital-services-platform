# Local development values only. Replace all secrets before public deployment.
SITE_ADDRESS=:80
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-before-deploying
DATABASE_URL=postgresql+asyncpg://platform:change-me-before-deploying@db:5432/platform
REDIS_URL=redis://redis:6379/0
OBJECT_STORAGE_ENDPOINT=http://object-storage:9000
OBJECT_STORAGE_BUCKET=platform-files
OBJECT_STORAGE_ACCESS_KEY=local-access-key
OBJECT_STORAGE_SECRET_KEY=change-me-before-deploying
TELEGRAM_BOT_TOKEN=
LOG_LEVEL=INFO
