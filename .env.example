# Local development values only. Replace all secrets before public deployment.
SITE_ADDRESS=:80
POSTGRES_DB=platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-before-deploying
BACKUP_RETENTION_DAYS=7
DATABASE_URL=postgresql+asyncpg://platform:change-me-before-deploying@db:5432/platform
REDIS_URL=redis://redis:6379/0
OBJECT_STORAGE_ENDPOINT=http://object-storage:9090
OBJECT_STORAGE_BUCKET=platform-files
OBJECT_STORAGE_ACCESS_KEY=test
OBJECT_STORAGE_SECRET_KEY=test
FILE_RETENTION_DAYS=30
MAX_UPLOAD_BYTES=20971520
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDERS_ENABLED=false
SERVICE_ACTIVATION_ENABLED=false
ADMIN_COOKIE_SECURE=true
LOG_LEVEL=INFO
